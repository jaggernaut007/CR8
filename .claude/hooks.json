{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check . --quiet && echo 'Ruff: OK'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check \"${CLAUDE_TOOL_INPUT_FILE_PATH}\" --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"${CLAUDE_TOOL_INPUT_COMMAND}\" | grep -q 'git commit' && (make lint --quiet || (echo 'Lint failed — run make lint-fix' && exit 1)) || true"
          },
          {
            "type": "command",
            "command": "echo \"${CLAUDE_TOOL_INPUT_COMMAND}\" | grep -q 'git commit' && bash .claude/hooks/pre-commit-docs-check.sh || true"
          }
        ]
      }
    ]
  }
}
